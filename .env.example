# Host Port Mappings (safe non-standard high ports to avoid collisions)
FRONTEND_PORT=23000
BACKEND_PORT=28080
DB_PORT=25432

# Database (for local non-docker runs)
DATABASE_URL=postgres://postgres:postgres@localhost:25432/agent_workbench?sslmode=disable

# Backend (for local non-docker runs)
PORT=28080
CORS_ORIGINS=http://localhost:23000
MIGRATIONS_PATH=./migrations

# Frontend (for local non-docker runs)
NEXT_PUBLIC_API_URL=http://localhost:28080

# Real model connection (API root, not /responses or /chat/completions)
# Supported: chat_completions (default), responses
LLM_API_FORMAT=chat_completions
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=
