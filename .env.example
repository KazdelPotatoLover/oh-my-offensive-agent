# Host Port Mappings (change if 5432, 3000 or 8080 are already in use on your machine)
DB_PORT=5433
FRONTEND_PORT=3001
BACKEND_PORT=8080

# Database (for local non-docker runs)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/agent_workbench?sslmode=disable

# Backend
PORT=8080
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
MIGRATIONS_PATH=./migrations

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
