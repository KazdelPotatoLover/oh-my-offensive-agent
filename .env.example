# Host Port Mappings (safe non-standard high ports to avoid collisions)
FRONTEND_PORT=23000
BACKEND_PORT=28080
DB_PORT=25432

# Database (for local non-docker runs)
DATABASE_URL=postgres://postgres:postgres@localhost:25432/agent_workbench?sslmode=disable

# Backend (for local non-docker runs)
PORT=28080
CORS_ORIGINS=http://localhost:23000
MIGRATIONS_PATH=./migrations

# Frontend (for local non-docker runs)
NEXT_PUBLIC_API_URL=http://localhost:28080

# Real model connection (API root, not /responses or /chat/completions)
# Supported: chat_completions (default), responses
LLM_API_FORMAT=chat_completions
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_API_KEY=

# Shared model request cap; worker count is configured per run.
LLM_MAX_INFLIGHT=2
LLM_MAX_OUTPUT_TOKENS=4096
LLM_MODEL_RECOVERY_ATTEMPTS=3

# Optional defaults for NEW exploration runs. Positive numbers are explicit caps.
# Omitted fields keep the builtin policy: 3 workers, no task deadline, no model/tool/
# planner/work-item hard cap, worker MaxTurns unlimited, worker run timeout 1200s.
# Settings freeze on the run. Existing runs keep their accepted grants.
# Example: {"max_parallel_workers":5,"run_timeout_seconds":3600}
OMA_EXPLORATION_BUDGET=

# Optional pointer overrides for new exploration runs. A present 0 means unlimited
# for that dimension. Worker count still must be 1-8. Example: {"task_timeout_seconds":0}
OMA_AGENT_LIMITS=

# Generated locally by python3 scripts/prepare-runtime.py. Never commit .env.
OMA_BROKER_TOKEN=
# Must be the same absolute path on the Docker host, API and broker.
OMA_WORKSPACE_ROOT=/tmp/oma-workspaces
